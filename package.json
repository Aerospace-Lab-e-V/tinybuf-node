{
  "name": "@asl-gokart/tinybuf-node",
  "version": "0.1.2",
  "description": "tinybuf Node.js bindings",
  "main": "index.js",
  "publishConfig": {
    "registry": "https://registry.leotm.de/",
    "access": "public"
  },
  "scripts": {
    "build": "cmake-js compile && bun build ./index.ts --outdir . --target node --format cjs",
    "build:ts": "bun build ./index.ts --outdir . --target node --format cjs",
    "build:native": "cmake-js compile",
    "electron-rebuild": "cmake-js compile --runtime=electron"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "cmake-js": "^8.0.0",
    "node-addon-api": "^8.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "files": [
    "index.js",
    "index.ts",
    "tsconfig.json",
    "*.node"
  ]
}
